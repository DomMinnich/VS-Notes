{
  "name": "VS-QuickNotes",
  "displayName": "VS-QuickNotes",
  "description": "A simple notes extension with pinned notes, color-coding, collapsible sections, quick templates, markdown support, global search, and more.",
  "version": "2.2.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "publisher": "DominicMinnich",
  "icon": "resources/icons/notes.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DomMinnich/VS-Notes"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:vsNotesView",
    "onCommand:VS-Notes.openNote",
    "onCommand:VS-Notes.newNote",
    "onCommand:VS-Notes.renameNote",
    "onCommand:VS-Notes.deleteNote",
    "onCommand:VS-Notes.pinNote",
    "onCommand:VS-Notes.unpinNote",
    "onCommand:VS-Notes.quickTemplate",
    "onCommand:VS-Notes.searchNotes"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vs-notes",
          "title": "VS Notes",
          "icon": "resources/icons/notes.png"
        }
      ]
    },
    "views": {
      "vs-notes": [
        {
          "id": "vsNotesView",
          "name": "Notes",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "VS-Notes.openNote",
        "title": "Open Note"
      },
      {
        "command": "VS-Notes.newNote",
        "title": "Create A New Note"
      },
      {
        "command": "VS-Notes.renameNote",
        "title": "Rename Note"
      },
      {
        "command": "VS-Notes.deleteNote",
        "title": "Delete Note"
      },
      {
        "command": "VS-Notes.pinNote",
        "title": "Pin Note"
      },
      {
        "command": "VS-Notes.unpinNote",
        "title": "Unpin Note"
      },
      {
        "command": "VS-Notes.quickTemplate",
        "title": "Create Note from Quick Template"
      },
      {
        "command": "VS-Notes.searchNotes",
        "title": "Search in Notes"
      },
      {
        "command": "VS-Notes.searchNotes",
        "title": "Live Search Notes"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "VS-Notes.renameNote",
          "when": "viewItem == pinnedNoteItem || viewItem == regularNoteItem",
          "group": "navigation"
        },
        {
          "command": "VS-Notes.deleteNote",
          "when": "viewItem == pinnedNoteItem || viewItem == regularNoteItem",
          "group": "navigation@1"
        },
        {
          "command": "VS-Notes.pinNote",
          "when": "viewItem == regularNoteItem",
          "group": "navigation@2"
        },
        {
          "command": "VS-Notes.unpinNote",
          "when": "viewItem == pinnedNoteItem",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.1",
    "typescript": "^5.5.4",
    "eslint": "^8.34.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
